<?xml version="1.0"?>
<!--
  RIOSE MVP 3 base world for Gazebo Harmonic / SDFormat 1.9.

  Edit the two include <pose> elements below to configure the initial model
  poses. Values are x y z roll pitch yaw in metres and radians.
-->
<sdf version="1.9">
  <world name="riose_mvp3">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.28 0.30 0.27 1</ambient>
      <background>0.66 0.76 0.83 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Keep the default server systems explicit because specifying world
         plugins overrides Gazebo Sim's automatic default-system loading. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.92 0.88 0.78 1</diffuse>
      <specular>0.32 0.30 0.26 1</specular>
      <direction>-0.42 0.31 -0.86</direction>
    </light>

    <!--
      The broad ground collision remains planar so experiment contact and
      trajectory results stay comparable. Field dressing below is visual/static
      context; it is not a terrain or vegetation physics model.
    -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.38 0.43 0.34 1</ambient>
            <diffuse>0.38 0.43 0.34 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A restrained paddock gives the animal and receiver a useful scale cue. -->
    <model name="paddock_fence" canonical_link="post_00">
      <static>true</static>
      <link name="post_00">
        <collision name="post_collision"><pose>-9 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry></collision>
        <visual name="post_00_visual"><pose>-9 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry><material><ambient>0.20 0.15 0.10 1</ambient><diffuse>0.29 0.21 0.13 1</diffuse><specular>0.08 0.07 0.05 1</specular></material></visual>
        <collision name="post_01_collision"><pose>-3 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry></collision>
        <visual name="post_01_visual"><pose>-3 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry><material><ambient>0.20 0.15 0.10 1</ambient><diffuse>0.29 0.21 0.13 1</diffuse></material></visual>
        <collision name="post_02_collision"><pose>3 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry></collision>
        <visual name="post_02_visual"><pose>3 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry><material><ambient>0.20 0.15 0.10 1</ambient><diffuse>0.29 0.21 0.13 1</diffuse></material></visual>
        <collision name="post_03_collision"><pose>9 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry></collision>
        <visual name="post_03_visual"><pose>9 5.5 0.62 0 0 0</pose><geometry><box><size>0.14 0.14 1.24</size></box></geometry><material><ambient>0.20 0.15 0.10 1</ambient><diffuse>0.29 0.21 0.13 1</diffuse></material></visual>
        <collision name="rail_lower_collision"><pose>0 5.5 0.42 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry></collision>
        <visual name="rail_lower"><pose>0 5.5 0.42 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="rail_upper_collision"><pose>0 5.5 0.98 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry></collision>
        <visual name="rail_upper"><pose>0 5.5 0.98 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="far_rail_lower_collision"><pose>0 -5.5 0.42 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry></collision>
        <visual name="far_rail_lower"><pose>0 -5.5 0.42 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="far_rail_upper_collision"><pose>0 -5.5 0.98 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry></collision>
        <visual name="far_rail_upper"><pose>0 -5.5 0.98 0 0 0</pose><geometry><box><size>18 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="end_rail_left_lower_collision"><pose>-9 0 0.42 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry></collision>
        <visual name="end_rail_left_lower"><pose>-9 0 0.42 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="end_rail_left_upper_collision"><pose>-9 0 0.98 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry></collision>
        <visual name="end_rail_left_upper"><pose>-9 0 0.98 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="end_rail_right_lower_collision"><pose>9 0 0.42 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry></collision>
        <visual name="end_rail_right_lower"><pose>9 0 0.42 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
        <collision name="end_rail_right_upper_collision"><pose>9 0 0.98 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry></collision>
        <visual name="end_rail_right_upper"><pose>9 0 0.98 0 0 1.570796</pose><geometry><box><size>11 0.08 0.10</size></box></geometry><material><ambient>0.24 0.17 0.11 1</ambient><diffuse>0.34 0.24 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Water point is outside the nominal x-axis trajectory. -->
    <model name="water_trough">
      <static>true</static>
      <pose>4.0 2.2 0 0 0 0</pose>
      <link name="body">
        <collision name="base_collision"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>1.65 0.58 0.55</size></box></geometry></collision>
        <visual name="basin"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>1.65 0.58 0.55</size></box></geometry><material><ambient>0.28 0.31 0.30 1</ambient><diffuse>0.42 0.47 0.45 1</diffuse><specular>0.48 0.48 0.44 1</specular></material></visual>
        <visual name="water"><pose>0 0 0.615 0 0 0</pose><geometry><box><size>1.48 0.43 0.012</size></box></geometry><material><ambient>0.15 0.22 0.23 1</ambient><diffuse>0.22 0.33 0.34 1</diffuse><specular>0.3 0.34 0.34 1</specular></material></visual>
        <visual name="support_left"><pose>-0.58 0 -0.02 0 0 0</pose><geometry><box><size>0.12 0.48 0.66</size></box></geometry><material><ambient>0.22 0.20 0.16 1</ambient><diffuse>0.32 0.29 0.23 1</diffuse></material></visual>
        <visual name="support_right"><pose>0.58 0 -0.02 0 0 0</pose><geometry><box><size>0.12 0.48 0.66</size></box></geometry><material><ambient>0.22 0.20 0.16 1</ambient><diffuse>0.32 0.29 0.23 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Distant shed provides a quiet agricultural backdrop and scale. -->
    <model name="field_shed">
      <static>true</static>
      <pose>-13 9 0 0 0 0</pose>
      <link name="structure">
        <visual name="walls"><pose>0 0 1.65 0 0 0</pose><geometry><box><size>5.4 3.8 3.3</size></box></geometry><material><ambient>0.47 0.43 0.35 1</ambient><diffuse>0.60 0.54 0.43 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 3.45 0 0 0</pose><geometry><box><size>5.9 4.2 0.28</size></box></geometry><material><ambient>0.20 0.22 0.21 1</ambient><diffuse>0.29 0.32 0.30 1</diffuse><specular>0.16 0.16 0.15 1</specular></material></visual>
        <visual name="open_bay"><pose>2.73 0 1.3 0 0 0</pose><geometry><box><size>0.025 1.9 2.6</size></box></geometry><material><ambient>0.14 0.15 0.14 1</ambient><diffuse>0.18 0.20 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- One stationary receiver anchor, placed beside the cow's +X travel
         path so it does not act as a collision obstacle during walking runs.
         Radio event handling is supplied by the MVP3 bridge. -->
    <model name="riose_anchor" canonical_link="mast" placement_frame="mast">
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name="mast">
        <collision name="mast_collision">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>0.12 0.12 1.6</size></box></geometry>
        </collision>
        <visual name="mast_visual">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>0.12 0.12 1.6</size></box></geometry>
          <material>
            <ambient>0.12 0.20 0.27 1</ambient>
            <diffuse>0.12 0.20 0.27 1</diffuse>
          </material>
        </visual>
        <collision name="receiver_collision">
          <pose>0 0 1.72 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.24</length></cylinder></geometry>
        </collision>
        <visual name="receiver_visual">
          <pose>0 0 1.72 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.24</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.35 0.78 1</ambient>
            <diffuse>0.12 0.35 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Resolve model:// URIs by adding the MVP3 gazebo/models directory to
         GZ_SIM_RESOURCE_PATH in the launch environment. -->
    <include>
      <uri>model://riose_cow</uri>
      <name>riose_cow</name>
      <pose relative_to="world">0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
